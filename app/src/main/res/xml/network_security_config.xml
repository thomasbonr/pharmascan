<?xml version="1.0" encoding="utf-8"?>
<!--
  Home Assistant tourne très souvent en HTTP simple sur le réseau local.
  Depuis Android 9 (API 28), le trafic en clair est bloqué par défaut.

  L'utilisateur configure lui-même l'URL dans les réglages : on autorise
  le trafic en clair vers n'importe quel hôte local. L'API Médicaments FR
  (seul autre appel réseau de l'appli) utilise HTTPS dans tous les cas.

  Si tu accèdes à HA en HTTPS via un reverse proxy, ce fichier n'a aucun
  effet : tout le trafic est déjà chiffré.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
