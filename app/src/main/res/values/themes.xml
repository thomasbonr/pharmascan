<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème XML minimal. Toute l'interface est dessinée par Compose : ce thème
      ne sert qu'à la fenêtre elle-même (fond, barres système) avant que
      Compose ne prenne la main. Un fond sombre évite le flash blanc au
      lancement, très visible quand on ouvre l'appli dans un placard.

      Pas de dépendance à AppCompat ni à Material Components : on hérite du
      thème plateforme, ce qui allège le projet.
    -->
    <style name="Theme.PharmaScan" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
