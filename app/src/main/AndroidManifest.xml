<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- required="false" : l'appli reste installable et utilisable en saisie
         manuelle sur un appareil sans caméra (tablette, émulateur). -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- networkSecurityConfig : Home Assistant tourne souvent en HTTP simple
         sur le réseau local, bloqué par défaut depuis Android 9. Le fichier
         référencé n'ouvre le clair que vers les hôtes explicitement listés. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PharmaScan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PharmaScan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Réglages"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.PharmaScan" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="Historique"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.PharmaScan" />

        <!-- Télécharge le modèle DataMatrix à l'installation plutôt qu'au
             premier scan : évite un premier lancement qui ne scanne rien. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

    </application>
</manifest>
